# Use Ubuntu as the base image
FROM ubuntu:20.04

# Set environment variables to suppress interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Set required Weaviate environment variables
ENV PERSISTENCE_DATA_PATH="/var/lib/weaviate"
ENV QUERY_DEFAULTS_LIMIT="25"
ENV AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED="true"
ENV ENABLE_MODULES="none"
ENV CLUSTER_HOSTNAME="node1"
ENV DEFAULT_VECTORIZER_MODULE=none
ENV LOG_LEVEL="debug"

# Install required dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    nginx \
    curl \
    git \
    tzdata && \
    rm -rf /var/lib/apt/lists/*

# Install Weaviate manually
RUN apt-get update && apt-get install -y --no-install-recommends iputils-ping net-tools ca-certificates
RUN curl -I https://github.com/weaviate/weaviate/releases/latest
RUN curl -fsSL -o /tmp/weaviate.tar.gz https://github.com/weaviate/weaviate/releases/download/v1.28.8/weaviate-v1.28.8-linux-amd64.tar.gz
RUN tar -xzf /tmp/weaviate.tar.gz -C /usr/local/bin/
RUN chmod +x /usr/local/bin/weaviate

# Clone the Weaviate Playground UI from your forked repository
RUN git clone https://github.com/cnburke/weaviate-playground.git /tmp/weaviate-playground && \
    mv /tmp/weaviate-playground /usr/share/nginx/html/

# Copy custom Nginx config
COPY nginx.conf /etc/nginx/sites-enabled/default

# Expose Weaviate API (8080) and Playground UI (80)
EXPOSE 8080 80

# Start both Weaviate and Nginx, ensuring Weaviate doesn't exit
CMD ["sh", "-c", "service nginx start && weaviate --host 0.0.0.0 --port ${PORT} || tail -f /dev/null"]