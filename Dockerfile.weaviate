# Use Ubuntu instead of the Weaviate base image
FROM ubuntu:20.04

# Install Weaviate and dependencies
RUN apt update && apt install -y wget nginx curl && \
    rm -rf /var/lib/apt/lists/*

# Install Weaviate manually
RUN wget -q https://github.com/semi-technologies/weaviate/releases/download/v1.18.3/weaviate-linux-amd64 -O /usr/local/bin/weaviate && \
    chmod +x /usr/local/bin/weaviate

# Copy custom Nginx config
COPY nginx.conf /etc/nginx/sites-enabled/default

# Download and extract Weaviate Playground UI
RUN wget -O playground.tar.gz https://github.com/RVledder/weaviate-playground/releases/latest/download/playground.tar.gz && \
    tar -xzf playground.tar.gz -C /usr/share/nginx/html/

# Expose Weaviate (8080) and Playground UI (80)
EXPOSE 8080 80

# Start Nginx and Weaviate
CMD service nginx start && weaviate